{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "ESNext",
    "verbatimModuleSyntax": true,
    "strict": true,
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "lib": ["es2022", "dom"]
  },
  "include": [
    "vendor/ecctrl/index.ts",
    "vendor/ecctrl/character/**/*.ts",
    "vendor/ecctrl/character/**/*.tsx",
    "vendor/ecctrl/curves/CurveLUT.ts",
    "vendor/ecctrl/gravity/useCustomGravity.ts",
    "vendor/ecctrl/shared/**/*.ts",
    "vendor/ecctrl/time.ts",
    "vendor/ecctrl/time/TimeControl.tsx"
  ],
  "exclude": ["node_modules", "../ecctrl-lab"]
}
